/* ═══════════════════════════════════════════════════════════
   SignTalk  –  Professional Dark Theme  (QSS v2.0)
   ═══════════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────────── */
QWidget {
    background-color: #0f172a;
    color: #e2e8f0;
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
    border: none;
}

/* ── Scrollbar ──────────────────────────────────────────── */
QScrollBar:vertical {
    background: #1e293b;
    width: 7px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 3px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #3b82f6;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── Sidebar ────────────────────────────────────────────── */
QFrame#sidebar {
    background-color: #0d1829;
    border-right: 1px solid #1e3a5f;
}

QLabel#sidebarLogo {
    font-size: 38px;
    padding-top: 4px;
    background: transparent;
}
QLabel#sidebarTitle {
    color: #f8fafc;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
}
QLabel#sidebarSub {
    color: #475569;
    font-size: 11px;
    background: transparent;
}
QLabel#sidebarFooter {
    color: #334155;
    font-size: 10px;
    background: transparent;
}
QLabel#statChip {
    color: #64748b;
    font-size: 11px;
    background: #111827;
    border-radius: 6px;
    padding: 4px 10px;
}

/* Sidebar nav buttons */
QPushButton#sideButton {
    background: transparent;
    color: #64748b;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#sideButton:hover {
    background: #1a2a40;
    color: #cbd5e1;
}
QPushButton#sideButtonActive {
    background: #0e2240;
    color: #38bdf8;
    border-left: 3px solid #38bdf8;
    border-radius: 0 8px 8px 0;
    text-align: left;
    padding: 0 11px;
    font-size: 13px;
    font-weight: 700;
}

/* ── Content Frame ──────────────────────────────────────── */
QWidget#contentFrame {
    background-color: #0f172a;
}

QLabel#headerTitle {
    color: #f1f5f9;
    font-size: 22px;
    font-weight: 700;
    background: transparent;
}
QLabel#headerSubtitle {
    color: #475569;
    font-size: 12px;
    background: transparent;
}

/* ── Camera ─────────────────────────────────────────────── */
QFrame#cameraContainer {
    background-color: #38bdf8;
    border-radius: 14px;
}
QLabel#cameraView {
    background-color: #020617;
    border-radius: 12px;
}

/* ── Info Cards ─────────────────────────────────────────── */
QFrame#infoCard {
    background: #111827;
    border: 1px solid #1e3a5f;
    border-radius: 12px;
}
QLabel#cardLabel {
    color: #475569;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    background: transparent;
}
QLabel#cardValue {
    color: #f1f5f9;
    font-size: 19px;
    font-weight: 600;
    background: transparent;
    padding-top: 3px;
}

/* ── Emotion Badge ──────────────────────────────────────── */
QLabel#emotionBadge {
    background: #111827;
    border-radius: 8px;
    padding: 4px 16px;
    font-size: 13px;
    font-weight: 600;
    color: #94a3b8;
}

/* ── Action Buttons ─────────────────────────────────────── */
QPushButton#primaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                    stop:0 #0284c7, stop:1 #38bdf8);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    padding: 0 22px;
}
QPushButton#primaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                    stop:0 #0369a1, stop:1 #0284c7);
}
QPushButton#primaryButton:pressed {
    background: #075985;
}

QPushButton#secondaryButton {
    background: #111827;
    color: #64748b;
    border: 1px solid #1e3a5f;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 0 20px;
}
QPushButton#secondaryButton:hover {
    background: #1a2a40;
    color: #cbd5e1;
}

/* ── Status Bar ─────────────────────────────────────────── */
QLabel#statusBar {
    color: #334155;
    font-size: 12px;
    background: transparent;
}

/* ── Settings ───────────────────────────────────────────── */
QLabel#settingLabel {
    color: #94a3b8;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QSlider::groove:horizontal {
    height: 5px;
    background: #1e3a5f;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #38bdf8;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin: -6px 0;
}
QSlider::handle:horizontal:hover {
    background: #7dd3fc;
}
QSlider::sub-page:horizontal {
    background: #38bdf8;
    border-radius: 3px;
}

QCheckBox#settingCheck {
    color: #94a3b8;
    font-size: 13px;
    spacing: 10px;
    background: transparent;
}
QCheckBox#settingCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 2px solid #1e3a5f;
    background: #111827;
}
QCheckBox#settingCheck::indicator:checked {
    background: #38bdf8;
    border-color: #38bdf8;
}
QCheckBox#settingCheck::indicator:hover {
    border-color: #38bdf8;
}

/* ── Separator ──────────────────────────────────────────── */
QFrame#separator {
    background: #1e3a5f;
    max-height: 1px;
    border: none;
}

/* ── About ──────────────────────────────────────────────── */
QLabel#aboutText {
    color: #64748b;
    font-size: 13px;
    background: transparent;
}

/* ═══════════════════════════════════════════════════
   TEXT TO SIGN PANEL
   ═══════════════════════════════════════════════════ */

QTextEdit#ttsInput {
    background-color: #111827;
    color: #f1f5f9;
    border: 1px solid #1e3a5f;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 14px;
}
QTextEdit#ttsInput:focus {
    border: 2px solid #38bdf8;
}

QFrame#ttsCard {
    background-color: #0a1628;
    border: 2px solid #1e3a5f;
    border-radius: 18px;
}

QLabel#ttsCounter {
    color: #334155;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    background: transparent;
}

QLabel#ttsWordLabel {
    color: #38bdf8;
    font-size: 36px;
    font-weight: 800;
    letter-spacing: 3px;
    background: transparent;
}

QLabel#ttsEmojiLabel {
    background: transparent;
    padding: 0px;
}

QLabel#ttsShapeLabel {
    color: #64748b;
    font-size: 14px;
    font-weight: 500;
    background: transparent;
    padding: 0 20px;
}

QProgressBar#ttsProgress {
    background-color: #1e3a5f;
    border-radius: 4px;
    border: none;
}
QProgressBar#ttsProgress::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #0284c7, stop:1 #38bdf8);
    border-radius: 4px;
}